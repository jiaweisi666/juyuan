# ================= AI 模型聚合网关 - 环境变量示例 =================
# 复制为 .env 后按需修改

# ---------- 服务监听（安全约束：管理面板默认仅监听 127.0.0.1）----------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8300
GATEWAY_DEBUG=true

# 允许跨源访问管理面板的前端开发地址（逗号分隔）
GATEWAY_CORS_ORIGINS=http://127.0.0.1:5273,http://localhost:5273

# ---------- 对外 API Key ----------
# 第三方应用调用 /v1/* 时需要携带的 Key（Bearer / x-api-key）
# 留空表示本机访问免鉴权（仅建议在本机 127.0.0.1 下使用）
GATEWAY_API_KEY=sk-juyuan-local

# 管理面板接口令牌（前端 X-Admin-Token），留空表示仅本机可访问
GATEWAY_ADMIN_TOKEN=juyuan-admin

# ---------- 数据存储 ----------
# 数据库、账号文件、密钥文件的存放目录（默认 ./data）
GATEWAY_DATA_DIR=

# 敏感字段（Cookie / sessionKey）加密主密钥；留空则自动生成并保存到 data/secret.key
GATEWAY_SECRET_KEY=

# ---------- 账号池与防封号 ----------
# 单账号每分钟最大请求数
GATEWAY_ACCOUNT_RPM=12
# 触发限流后的冷却秒数（429/风控）
GATEWAY_COOLDOWN_SECONDS=90
# 请求之间的随机延迟区间（秒），模拟人类节奏
GATEWAY_MIN_DELAY_SECONDS=0.3
GATEWAY_MAX_DELAY_SECONDS=1.2
# 全局并发上限（默认 1-2）
GATEWAY_MAX_CONCURRENCY=2
# 后台保活健康检查间隔（秒），0 表示关闭
GATEWAY_KEEPALIVE_INTERVAL=300

# ---------- AUTO 智能路由 ----------
# 默认是否开启 AUTO 智能路由
GATEWAY_AUTO_ROUTER_ENABLED=true
# 路由权重（准确率 / 延迟 / 成本），三者会被归一化
GATEWAY_WEIGHT_ACCURACY=0.5
GATEWAY_WEIGHT_LATENCY=0.2
GATEWAY_WEIGHT_COST=0.3
# 是否启用基于历史反馈的画像自优化
GATEWAY_FEEDBACK_OPTIMIZE=true
# 画像自优化执行间隔（秒）
GATEWAY_PROFILE_REFRESH_INTERVAL=3600

# ---------- 平台适配 ----------
# 是否启用真实网页自动化（需要安装 requirements-web.txt 并具备已登录浏览器）
GATEWAY_REAL_BROWSER_ENABLED=false
# 未启用真实浏览器时，是否回退到模拟适配器
GATEWAY_MOCK_FALLBACK=true
# 底座 universal-web-api 目录（真实网页适配器用于读取 sites.json 选择器）
GATEWAY_VENDOR_DIR=../vendor/universal-web-api
# 底座 universal-web-api 服务地址（真实网页适配器通过其 OpenAI 兼容接口转发）
GATEWAY_BASE_WEB_API_URL=http://127.0.0.1:8199
# 底座服务鉴权 Key（如底座开启了鉴权）
GATEWAY_BASE_WEB_API_KEY=
# 动态模型目录（底座 /v1/models）缓存有效秒数；网页端迭代后会自动同步模型名
GATEWAY_MODEL_CACHE_TTL=600
